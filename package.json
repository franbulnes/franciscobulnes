  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-icons": "^1.3.2",
    "@vitejs/plugin-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "simple-icons": "^16.35.0",
    "vite": "latest"
  },
  "devDependencies": {
    "agentation": "^3.1.2",
    "sharp": "^0.35.5"
  }
}
